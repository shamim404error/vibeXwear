# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/vibexwear

# Admin Authentication Secret (JWT)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=8h

# Admin Default Credentials (For initial seed)
DEFAULT_ADMIN_EMAIL=admin@vibexwear.com
DEFAULT_ADMIN_PASSWORD=admin123456
